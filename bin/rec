#!/usr/bin/env sh

if [ $# -eq 0 ]; then
    printf "Filename: "
    read -r filename
else
    filename="$1"
fi

if [ -z "$filename" ]; then
    echo "Error: No filename provided"
    exit 1
fi

filename=$(echo "$filename" | sed 's/ /-/g')

# add .mp4 extension if not present
case "$filename" in
    *.mp4) ;;
    *) filename="${filename}.mp4" ;;
esac

# When invoked without a display (ssh / gnu screen), attach to the running
# X session so we can record it.
if [ -z "${DISPLAY:-}" ]; then
    xorg_pid=$(pgrep -x Xorg | head -1)
    if [ -z "$xorg_pid" ]; then
        echo "Error: no running X session found" >&2
        exit 1
    fi
    export DISPLAY=$(tr '\0' ' ' < /proc/$xorg_pid/cmdline | grep -oE ':[0-9]+' | head -1)
    export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export PULSE_SERVER="${PULSE_SERVER:-unix:/run/user/$(id -u)/pulse/native}"
fi

echo "Recording to: $filename"

# xrdp/remote sessions are software-rendered (llvmpipe); gpu-screen-recorder
# requires hardware OpenGL, so fall back to ffmpeg x11grab there.
if grep -qa "xorgxrdp" /proc/$(pgrep -f "Xorg ${DISPLAY%%.*}" | head -1)/cmdline 2>/dev/null; then
    resolution=$(xrandr 2>/dev/null | grep ' connected' | head -1 | grep -oE '[0-9]+x[0-9]+' | head -1)
    # capture the system output monitor (matches gsr's default_output) via pipewire-pulse
    default_sink=$(pw-dump 2>/dev/null | grep '"default.audio.sink"' | grep -oE '"name": "[^"]*"' | sed 's/"name": "//;s/"//')
    audio_input=""
    audio_codec=""
    [ -n "$default_sink" ] && { audio_input="-f pulse -i ${default_sink}.monitor"; audio_codec="-c:a aac"; }
    # VAAPI hardware encode; re-stamp to constant 30fps to avoid jitter / non-monotonic DTS.
    # ffmpeg's SIGINT path crashes the VAAPI encoder and corrupts the mp4, so run it
    # isolated (setsid) and quit cleanly via stdin 'q' on Ctrl+C instead.
    fifo=$(mktemp -u)
    mkfifo "$fifo"
    setsid ffmpeg -vaapi_device /dev/dri/renderD128 \
        -f x11grab -framerate 30 -video_size "${resolution:-1920x1080}" -i "$DISPLAY" \
        $audio_input \
        -vf 'format=nv12,setpts=N/(30*TB),hwupload' \
        -c:v h264_vaapi $audio_codec "$filename" \
        < "$fifo" &
    ffmpeg_pid=$!
    exec 3> "$fifo"
    trap 'printf "q\n" >&3' INT
    wait "$ffmpeg_pid" 2>/dev/null
    wait "$ffmpeg_pid" 2>/dev/null
    trap - INT
    exec 3>&-
    rm -f "$fifo"
else
    export WAYLAND_DISPLAY=wayland-0
    gpu-screen-recorder -w screen -f 30 -a default_output -cursor no -o "$filename"
fi

#!/usr/bin/env sh

if [ $# -eq 0 ]; then
    printf "Filename: "
    read -r filename
else
    filename="$1"
fi

if [ -z "$filename" ]; then
    echo "Error: No filename provided"
    exit 1
fi

filename=$(echo "$filename" | sed 's/ /-/g')

# add .mp4 extension if not present
case "$filename" in
    *.mp4) ;;
    *) filename="${filename}.mp4" ;;
esac

echo "Recording to: $filename"

# xrdp/remote sessions are software-rendered (llvmpipe); gpu-screen-recorder
# requires hardware OpenGL, so fall back to ffmpeg x11grab there.
if grep -qa "xorgxrdp" /proc/$(pgrep -f "Xorg ${DISPLAY%%.*}" | head -1)/cmdline 2>/dev/null; then
    resolution=$(xrandr 2>/dev/null | grep ' connected' | head -1 | grep -oE '[0-9]+x[0-9]+' | head -1)
    # capture the system output monitor (matches gsr's default_output) via pipewire-pulse
    default_sink=$(pw-dump 2>/dev/null | grep '"default.audio.sink"' | grep -oE '"name": "[^"]*"' | sed 's/"name": "//;s/"//')
    audio_args=""
    [ -n "$default_sink" ] && audio_args="-f pulse -i ${default_sink}.monitor -c:a aac"
    ffmpeg -f x11grab -framerate 30 -video_size "${resolution:-1920x1080}" -i "$DISPLAY" \
        $audio_args \
        -c:v libx264 -preset fast -pix_fmt yuv420p "$filename"
else
    export WAYLAND_DISPLAY=wayland-0
    gpu-screen-recorder -w screen -f 30 -a default_output -cursor no -o "$filename"
fi
